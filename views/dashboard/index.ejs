<div class="cards">
    <div class="card-single-kpi">
        <div>
            <h3>
                <%= locals.netProfitMargin %> %
            </h3>
            <span>Fund KPI I</span>
        </div>
        <div>
            <span class="las la-clipboard"></span>
        </div>
    </div>
    <div class="card-single-kpi">
        <div>
            <h3>
                <%= locals.cashFlowRate %> %
            </h3>
            <span>Fund KPI II</span>
        </div>
        <div>
            <span class="las la-clipboard"></span>
        </div>
    </div>
    <div class="card-single-kpi">
        <div>
            <h3>
                <%= locals.liquidity %> %
            </h3>
            <span>Fund KPI III</span>
        </div>
        <div>
            <span class="las la-clipboard"></span>
        </div>
    </div>
    <div class="card-single-kpi">
        <canvas id="npm-chart"></canvas>
    </div>
    <div class="card-single-kpi">
        <canvas id="cfr-chart"></canvas>
    </div>
    <div class="card-single-kpi">
        <canvas id="liq-chart"></canvas>
    </div>
    <div class="card-single-table">
        <div id="table" class="ag-theme-alpine"></div>
    </div>
</div>

</div>
<script src="/js/chart/fund-chart.js"></script>
<script src="/js/chart/chart.min.js"></script>
<script src="/js/table/table.js"></script>
<script src="/js/table/ag-grid-community.min.js"></script>