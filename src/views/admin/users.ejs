<div>
    <div>
        <div>
            <h2>Add User</h2>
            <div id="add-user-inputs">
                <div>
                    <label for="first-name">First Name:</label>
                    <input required type="text" id="first-name" name="firstName">
                </div>
                <div>
                    <label for="last-name">Last Name:</label>
                    <input required type="text" id="last-name" name="lastName">
                </div>
                <div>
                    <div>
                        <label for="email">Email:</label>
                        <input required type="email" id="email" name="email">
                    </div>
                </div>
                <div>
                    <label for="password">Password:</label>
                    <input required type="password" id="password" name="password">
                </div>
                <div>
                    <label for="role">Role:</label>
                    <select name="role" id="role" required>
                        <option value="admin">Admin</option>
                        <option value="fund">Fund</option>
                        <option value="startup">Startup</option>
                    </select>
                </div>
                <div id="fund-input" class="hidden">
                    <label for="fund">Fund:</label>
                    <select name="fund" id="fund" required>
                        <% for (const fund of funds) { %>
                            <option value="<%= fund.id %>"><%= fund.name %></option>
                        <% } %> 
                    </select>
                </div>
                <div id="startup-input" class="hidden">
                    <label for="startup">Startup:</label>
                    <select name="startup" id="startup">
                        <% for (const startup of startups) { %>
                            <option value="<%= startup.id %> "><%= startup.name %></option>
                        <% } %> 
                    </select>
                </div>
            </div>
            <button id="submit-new-user">Submit new User</button>
        </div>
        <div>
            <div id="email-taken" class="hidden">
                <label id="email-taken">Email already taken</label>
            </div>
            <div id="insert-status" class="hidden">
                <h3>New User Added:</h3>
                <div>
                    <label>First Name:</label>
                    <input type="text" disabled id="added-first-name">
                </div>
                <div>
                    <label >Last Name:</label>
                    <input type="text" disabled id="added-last-name">
                </div>
                <div>
                    <label>Email:</label>
                    <input type="text" disabled id="added-email">
                </div>
                <div>
                    <label>Password:</label>
                    <input type="password" disabled id="added-password">
                    <button id="show-pw">Show Password</button>
                </div>
                <div>
                    <label>Role:</label>
                    <input type="text" disabled id="added-role">
                </div>
                <div>
                    <label>Fund:</label>
                    <input type="text" disabled id="added-fund">
                </div>
                <div>
                    <label>Startup:</label>
                    <input type="text" disabled id="added-startup">
                </div>
            </div>
        </div>
    </div>
    <br>
    <div>
        <h2>Edit User</h2>
                <select name="users" id="users">
                    <option value="" selected disabled>Select User</option>
                    <% for (const user of users) { %> 
                       <option value="<%= user.id %>"><%= user.firstName %> <%= user.lastName %></option>
                    <% } %> 
                </select>
                <div id="new-user" class="hidden">
                    <div>
                        <label for="new-first-name">First Name:</label>
                        <input type="text" id="new-first-name">
                    </div>
                    <div>
                        <label for="new-last-name">Last Name:</label>
                        <input type="text" id="new-last-name">
                    </div>
                    <div>
                        <label for="new-email">Email:</label>
                        <input type="email" id="new-email">
                    </div>
                    <div>
                        <label for="new-password">Email:</label>
                        <input type="password" id="new-password">
                    </div>
                    <div>
                        <input type="hidden" name="id" id="same-id">
                    </div>
                    <button id="submit-new-credentials">Submit Edited User</button>
                </div>
        </div>
    </div>
    <br>
    <div>
        <h2>Delete</h2>
        <select name="id" id="select-delete-users">
            <option value="" selected disabled>Select User</option>
            <% for (const user of users) { %>
                <option value="<%= user.id %>"><%= user.firstName %> <%= user.lastName %></option>
            <% } %> 
        </select>
        <button type="button" id="delete-btn">Delete User</button>
        <div id="chose-delete" class="hidden">
            Are you sure you want to delete this user?
            <button type="button" id="yes-delete-btn">Yes</button>
            <button type="button" id="dont-delete">No</button>
        </div>
    </div>
</div>