<div>
    <h2>Add User</h2>
    <form action="/admin/add-users" method="POST">
        <div>
            <label for="first-name">First Name:</label>
            <input type="text" id="first-name">
        </div>
        <div>
            <label for="last-name">Last Name:</label>
            <input type="text" id="last-name">
        </div>
        <div>
            <label for="email">Email:</label>
            <input type="email" id="email">
        </div>
        <div>
            <label for="role">Role:</label>
            <select name="role" id="role">
                <option value="admin">Admin</option>
                <option value="fund">Fund</option>
                <option value="startup">Startup</option>
            </select>
        </div>
        <div id="fund-input" class="hidden">
            <label for="fund">Fund:</label>
            <select name="fund" id="fund">
                <% for (const fund of funds) { %>
                    <option value="<%= fund.id %> "><%= fund.name %></option>
                    <% } %> 
            </select>
        </div>
        <div id="startup-input" class="hidden">
            <label for="startup">Startup:</label>
            <select name="startup" id="startup">
                <% for (const startup of startups) { %>
                    <option value="<%= startup.id %> "><%= startup.name %></option>
                <% } %> 
            </select>
        </div>
        <input type="submit" value="Submit new user">
    </form>
</div>
<br>
<div>
    <h2>Edit User</h2>
        <form action="/admin/edit-users" method="POST">
            <select name="users" id="users">
                <% for (const user of users) { %> 
                   <option value="<%= user.id %>"><%= user.firstName %> <%= user.lastName %></option>
                <% } %> 
            </select>
            <div id="new-user" class="hidden">
                <div>
                    <label for="new-first-name">First Name:</label>
                    <input type="text" id="new-first-name">
                </div>
                <div>
                    <label for="new-last-name">Last Name:</label>
                    <input type="text" id="new-last-name">
                </div>
                <div>
                    <label for="new-email">Email:</label>
                    <input type="email" id="new-email">
                </div>
                <input type="submit" value="Submit new user">
        </form>
    </div>
</div>
<br>
<div>
    <h2>Delete</h2>
        <form action="/admin/delete-users" method="POST">
            <select name="users" id="select-deleteusers">
                <% for (const user of users) { %>
                   <option value="<%= user.id %>"><%= user.firstName %> <%= user.lastName %></option>
                <% } %> 
            </select>
            <button type="button" id="delete-btn">Delete User</button>
            <div id="chose-delete" class="hidden">
               Are you sure you want to delete this user?
               <input type="submit" value="Yes">
               <button type="button" id="dont-delete">No</button>
            </div>
        </form>
    </div>
</div>