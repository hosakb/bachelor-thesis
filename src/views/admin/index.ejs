<div>
    <div>
        <h2>Overview</h2>
    </div>
    <br>
    <div>
        <h3>Funds</h3>
       <div>
        <table>
          <thead>
              <tr>
                <th>Name</th>
                <th>Created At</th>
                <th>Updated At</th>
              </tr>
          </thead>
          <tbody>
           <% for (const fund of funds) { %> 
            <tr>
                <td><%= fund.name %> </td>
                <td><%= fund.createdAt.getDate() + "-" + fund.createdAt.getMonth() + "-" + fund.createdAt.getFullYear() %></td>
                <td><%= fund.updatedAt.getDate() + "-" + fund.updatedAt.getMonth() + "-" + fund.updatedAt.getFullYear() %></td>
            </tr>
            <% } %> 
          </tbody>
        </table>
       </div>
    </div>
    <br>
    <div>
        <h3>Startups</h3>
        <div>
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Investment Phase</th>
                        <th>Created At</th>
                        <th>Updated At</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (const startup of startups) { %> 
                        <tr>
                            <td><%= startup.name %> </td>
                            <td><%= startup.stage %> </td>
                            <td><%= startup.createdAt.getDate() + "-" + startup.createdAt.getMonth() + "-" + startup.createdAt.getFullYear() %></td>
                            <td><%= startup.updatedAt.getDate() + "-" + startup.updatedAt.getMonth() + "-" + startup.updatedAt.getFullYear() %></td>
                        </tr>
                        <% } %> 
                </tbody>
            </table>
        </div>
    <br>
    <div>
        <h3>Users</h3>
        <div>
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Created At</th>
                        <th>Updated At</th>
                        <th>Startup</th>
                        <th>Fund</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (const user of users) { %> 
                        <tr>
                            <td><%= user.firstName + " " + user.lastName %></td>
                            <td><%= user.email %></td>
                            <td><%= user.role %></td>
                            <td><%= user.createdAt.getDate() + "-" + user.createdAt.getMonth() + "-" + user.createdAt.getFullYear() %></td>
                            <td><%= user.updatedAt.getDate() + "-" + user.updatedAt.getMonth() + "-" + user.updatedAt.getFullYear() %></td>
                            <td><%= user.startup %></td>
                            <td><%= user.fund %></td>
                        </tr>
                        <% } %> 
                </tbody>
            </table>
        </div>
    </div>
    </div>
    <br>
 
</div>