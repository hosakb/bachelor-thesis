<div class="cards">
    <div class="milestone-card">
        <h4>Milestones</h4>
       <div class="overflow-chart">
        <% if(dashboard == "fund") { %>
            <svg id="gantt" class="disable-interaction"></svg>
        <% } else if(dashboard == "startup") {%>
            <svg id="gantt"></svg>
        <% } %>
       </div>
       <div>
            <button onclick="change_view_mode('Day')">Day</button>
            <button onclick="change_view_mode('Week')">Week</button>
            <button onclick="change_view_mode('Month')">Month</button>
            <button onclick="change_view_mode('Year')">Year</button>
        </div>
        <div id="gantt-changes" class="hidden">
            <% if(dashboard == "startup") {%>
                <button id="gantt-changes-ok-btn">Ok</button>
                <button id="gantt-changes-cancel-btn">Cancel</button>
            <% } %>
        </div>
    </div>
    <div class="card-single-kpi">
        <div>
            <h3>
                <%= locals.kpis.numberOfEmployees %>
            </h3>
            <span>Number of Employees</span>
            <canvas id="noe-chart"></canvas>
        </div>
        <div>
            <span class="las la-clipboard"></span>
        </div>
    </div>
    <div class="card-single-kpi">
        <div>
            <h3>
                <%= locals.kpis.cashFlowRate %>
            </h3>
            <span>Cash-Flow Rate</span>
            <canvas id="cfr-chart"></canvas>
        </div>
        <div>
            <span class="las la-clipboard"></span>
        </div>
    </div>
    <div class="card-single-kpi">
        <div>
            <h3>
                <%= locals.kpis.liquidity %>
            </h3>
            <span>Liquidity</span>
            <canvas id="liq-chart"></canvas>
        </div>
        <div>
            <span class="las la-clipboard"></span>
        </div>
    </div>
    <% if(locals.startup != undefined) {%>
        <div class="card-single-kpi">
            <h3>Expertise</h3>
           <div>
            <canvas id="expertise-chart"></canvas>
           </div>
        </div> 
    <% } %>
    <% if(locals.capTable != undefined) { %> 
        <div class="card-single-kpi">
            <h3>Cap-Table</h3>
            <table id="cap-table">
                <% for(const row of locals.capTable) {%>
                    <tr>
                        <% for(const cell of row) {%>
                            <td>
                                <%= cell %> 
                            </td>
                        <% } %> 
                    </tr>
                <% } %> 
            </table>
        </div>
        <br>
    <% } %> 
</div>
 
