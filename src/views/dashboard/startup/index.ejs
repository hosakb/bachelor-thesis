<div class="cards">
    <div class="card-single-kpi">
       
    </div>
    <div class="card-single-kpi">
        <div>
            <h3>
                <%= locals.kpis.numberOfEmployees %>
            </h3>
            <span>Number of Employees</span>
        </div>
        <div>
            <span class="las la-clipboard"></span>
        </div>
    </div>
    <div class="card-single-kpi">
        <div>
            <h3>
                <%= locals.kpis.cashFlowRate %>
            </h3>
            <span>Cash-Flow Rate</span>
        </div>
        <div>
            <span class="las la-clipboard"></span>
        </div>
    </div>
    <div class="card-single-kpi">
        <div>
            <h3>
                <%= locals.kpis.liquidity %>
            </h3>
            <span>Liquidity</span>
        </div>
        <div>
            <span class="las la-clipboard"></span>
        </div>
    </div>
    <div class="card-single-kpi">
        <canvas id="noe-chart"></canvas>
    </div>
    <div class="card-single-kpi">
        <canvas id="cfr-chart"></canvas>
    </div>
    <div class="card-single-kpi">
        <canvas id="liq-chart"></canvas>
    </div>
    <% if(locals.startup != undefined) {%>
        <div class="card-single-kpi">
            <h3>Expertise</h3>
           <div>
            <canvas id="expertise-chart"></canvas>
           </div>
        </div> 
    <% } %>
    <% if(locals.capTable != undefined) { %> 
        <div class="card-single-kpi">
            <h3>Cap-Table</h3>
            <table id="cap-table">
                <% for(const row of locals.capTable) {%>
                    <tr>
                        <% for(const cell of row) {%>
                            <td>
                                <%= cell %> 
                            </td>
                        <% } %> 
                    </tr>
                <% } %> 
            </table>
        </div>
        <br>
    <% } %> 
</div>
