<body>
    <div class="submit-cards">
        <div class="submit-card">
            <h3>Manuel Input</h3>
            <form action="/submit/kpi-form" method="POST">
                <div>
                    <label for="netProfitMargin">Net Profit Margin</label>
                    <input name="netProfitMargin" type="number" name="">
                </div>
                <div>
                    <label for="cashFlowRate">Cash-Flow-Rate</label>
                    <input name="cashFlowRate" type="number">
                </div>
                <div>
                    <label for="liquidity">Liquidity</label>
                    <input name="liquidity" type="number">
                </div>
                <div>
                    <input type="submit">
                </div>
            </form>
        </div>
        <div class="submit-card">
            <h3>Upload Excel</h3>
            <% if (locals.kpis === undefined) { %>
            <form action="/submit" enctype="multipart/form-data" method="post">
                <input type="file" name="kpis" />
                <input type="submit">  
            </form>
            <% } else { %>
                <br>
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Net Profit Margin</th>
                            <th scope="col">Cash Flow Rate</th>
                            <th scope="col">Liquidity</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td id="date" scope="row"><%= locals.kpis.date %></td>
                            <td id="netProfitMargin"><label><%= locals.kpis.netProfitMargin %></label><label>%</label></td>
                            <td id="cashFlowRate"><label><%= locals.kpis.cashFlowRate %></label><label>%</label></td>
                            <td id="liquidity"><label><%= locals.kpis.liquidity %></label><label>%</label></td>
                        </tr>
                    </tbody>
                </table>
                <br>
                <div>
                    <label>Data correct?</label>
                    <br>
                    <button onclick="submitKpiData()">Yes</button>
                    <button onclick="reuploadKpiData()">No</button>
                </div>
                <% } %>
            <label name="success"><%= locals.success %></label>
        </div>
    </div>
</body>

<script src="/js/submit.js"></script>