<div>
    <div>
        <h1 class="title">Overview</h1>
    </div>
    <div class="grid">
        <div class="card">
            <h2>Users</h2>
            <br>
            <div class="table-container">
                <table class="admin-tbl">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Created At</th>
                            <th>Updated At</th>
                            <th>Startup</th>
                            <th>Fund</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (const user of users) { %>
                        <tr>
                            <td><%= user.firstName + " " + user.lastName %></td>
                            <td><%= user.email %></td>
                            <td><%= user.role %></td>
                            <td><%= user.createdAt.getDate() + "." + (user.createdAt.getMonth() + 1) + "." + user.createdAt.getFullYear() %></td>
                            <td><%= user.updatedAt.getDate() + "." + (user.updatedAt.getMonth() + 1) + "." + user.updatedAt.getFullYear() %></td>
                            <td><%= user.startup %></td>
                            <td><%= user.fund %></td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card">
            <h2>Funds</h2>
            <br>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Created At</th>
                            <th>Updated At</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (const fund of funds) { %>
                        <% if(fund.type == "fund") { %>
                        <tr>
                            <td><%= fund.name %> </td>
                            <td><%= fund.createdAt.getDate() + "." + (fund.createdAt.getMonth() + 1) + "." + fund.createdAt.getFullYear() %></td>
                            <td><%= fund.updatedAt.getDate() + "." + (fund.updatedAt.getMonth() + 1) + "." + fund.updatedAt.getFullYear() %></td>
                        </tr>
                        <% } %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card">
            <h2>Stakeholders</h2>
            <br>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Created At</th>
                            <th>Updated At</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (const fund of funds) { %>
                        <% if(fund.type == "stakeholder") { %>
                        <tr>
                            <td><%= fund.name %> </td>
                            <td><%= fund.createdAt.getDate() + "." + (fund.createdAt.getMonth() + 1) + "." + fund.createdAt.getFullYear() %></td>
                            <td><%= fund.updatedAt.getDate() + "." + (fund.updatedAt.getMonth() + 1) + "." + fund.updatedAt.getFullYear() %></td>
                        </tr>
                        <% } %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card">
            <h2>Startups</h2>
            <br>
            <div class="table-container">
                <table class="admin-tbl">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Investment Phase</th>
                            <th>Created At</th>
                            <th>Updated At</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (const startup of startups) { %>
                        <tr>
                            <td><%= startup.name %> </td>
                            <td><%= startup.stage %> </td>
                            <td><%= startup.createdAt.getDate() + "." + (startup.createdAt.getMonth() + 1) + "." + startup.createdAt.getFullYear() %></td>
                            <td><%= startup.updatedAt.getDate() + "." + (startup.updatedAt.getMonth() + 1) + "." + startup.updatedAt.getFullYear() %></td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
