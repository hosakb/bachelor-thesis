<h2>Welcome <%= founder %></h2>
<p>We are going to ask each founder a few question about you and your previous ventures to get a better picture about you and your expertise.</p>

<br>

<div class="form-item">
    <label for="expertise">What is your domain of expertise? If not listed please select other and submit your expertise.</label>
    <select id="expertise">
        <option value="IT">IT</option>
        <option value="Engineering">Engineering</option>
        <option value="Business">Business</option>
        <option value="Medicine">Medicine</option>
        <option value="Psychology">Psychology</option>
        <option value="Space">Space</option>
        <option value="Mathematics">Mathematics</option>
        <option value="Physics">Physics</option>
        <option value="Chemistry">Chemistry</option>
        <option value="Biology">Biology</option>
        <option value="other">Other</option>
    </select>
    <input id="other-expertise" class="hidden" type="text" placeholder="Other Expertise">
</div>
<br>
<div>
    <div class="form-item">
        <label>Is this your first venture?</label>
        <select id="first-venture">
            <option value="yes" selected>Yes</option>
            <option value="no">No</option>
        </select>
    </div>
    <br>
    <br>
    <div id="previous-ventures" class="hidden">
        <p>Please list all ventures you are a founding member of.</p>
        <button id="add-venture-btn">Add venture</button>
        <div class="venture-form hidden">
            <div class="form-item">
                <label for="venture-name">Venture name</label>
                <input id="venture-name" type="text">
            </div>
            <div class="form-item">
                <label for="founding-date">Founding date:</label>
                <input id="founding-date" type="date">
            </div>
            <div class="form-item">
                <label for="co-founders">How many co-founders did do you have?</label>
                <input id="co-founders" class="number-input" type="number">
            </div>
            <div class="form-item">
                <label for="last-valuation">Last Valuation</label><span> Million</span>
                <input type="number" id="last-valuation" min="0">
            </div>
            <div class="form-item">
                <label for="venture-in-business">Is it still in business?</label>
                <select id="venture-in-business">
                    <option value="yes" default>Yes</option>
                    <option value="no">No</option>
                </select>
            </div>
            <div id="reason-for-failure-hidden" class="form-item hidden">
                <label for="reason-for-fail">Why did it fail?</label>
                <textarea id="reason-for-fail" rows="5" cols="33"></textarea>
            </div>
            <button id="submit-venture-btn" class="hidden">Add</button>
            <label id="incompleteVentureForm"></label>
        </div>
        <br>
        <br>
    <div>
        <h2>Previous Ventures</h2>
        <table id="ventures">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Founding Date</th>
                    <th>Co-Founders</th>
                    <th>Still in Business</th>
                    <th>Last Valuation</th>
                    <th>Reason for Failure</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<button id="submit-track-record-btn">Submit Track-Record</button>