<div class="founder-cards">
    <div id="founders" class="card">
        <h2>Founders Track Records</h2>
        <br>
        <div class="vertical-table-container">
            <% if(founders.length != 0) {%>
            <table>
                <thead>
                    <tr>
                        <th>Founder Name</td>
                        <th>Venture Name</th>
                        <th>Founding Date</th>
                        <th>Co-Founders</th>
                        <th>Last Valuation (M)</th>
                        <th>Still in Business</th>
                        <th>Reason for Failure</th>
                    </tr>
                </thead>
                <tbody>
                    <% founders.forEach(founder => { %>
                    <% if(founder.trackRecord.ventures.length == 1) { %>
                    <tr>
                        <td>
                            <%= founder.firstName %> <%= founder.lastName %>
                        </td>
                        <td>
                            <%= founder.trackRecord.ventures[0].name %>
                        </td>
                        <td>
                            <%= founder.trackRecord.ventures[0].foundingDate %>
                        </td>
                        <td>
                            <%= founder.trackRecord.ventures[0].coFounders %>
                        </td>
                        <td>
                            <%= founder.trackRecord.ventures[0].lastValuation %>
                        </td>
                        <td>
                            <%= founder.trackRecord.ventures[0].inBusiness %>
                        </td>
                        <td>
                            <%= founder.trackRecord.ventures[0].reasonForFailure %>
                        </td>
                    </tr>
                    <% } else if(founder.trackRecord.ventures.length > 1) { %>
                    <tr>
                        <td rowspan="<%= founder.trackRecord.ventures.length %> ">
                            <%= founder.firstName %> <%= founder.lastName %>
                        </td>
                        <td>
                            <%= founder.trackRecord.ventures[0].name %>
                        </td>
                        <td>
                            <%= founder.trackRecord.ventures[0].foundingDate %>
                        </td>
                        <td>
                            <%= founder.trackRecord.ventures[0].coFounders %>
                        </td>
                        <td>
                            <%= founder.trackRecord.ventures[0].lastValuation %>
                        </td>
                        <td>
                            <%= founder.trackRecord.ventures[0].inBusiness %>
                        </td>
                        <td>
                            <%= founder.trackRecord.ventures[0].reasonForFailure %>
                        </td>
                    </tr>
                    <% for (let i = 1; i < founder.trackRecord.ventures.length; i++) { %>
                    <tr>
                        <td>
                            <%= founder.trackRecord.ventures[i].name %>
                        </td>
                        <td>
                            <%= founder.trackRecord.ventures[i].foundingDate %>
                        </td>
                        <td>
                            <%= founder.trackRecord.ventures[i].coFounders %>
                        </td>
                        <td>
                            <%= founder.trackRecord.ventures[i].lastValuation %>
                        </td>
                        <td>
                            <%= founder.trackRecord.ventures[i].inBusiness %>
                        </td>
                        <td>
                            <%= founder.trackRecord.ventures[i].reasonForFailure %>
                        </td>
                    </tr>
                    <% } %>
                    <% } else { %>
                    <tr>
                        <td> <%= founder.firstName %> <%= founder.lastName %></td>
                        <td colspan="6">No previous ventures</td>
                    </tr>
                    <% } %>
                </tbody>
                <% }); %>
            </table>
            <% } else { %>
            <div>No founders found.</div>
            <% }%>
        </div>
    </div>
    <br>

    <div id="cap-table" class="card">
        <h2>Cap-Table</h2>
        <div class="vertical-table-container">
            <% if(locals.capTable != undefined) { %>
            <table id="cap-table">
                <% for(const row of locals.capTable) {%>
                <tr>
                    <% for(const cell of row) {%>
                    <td>
                        <%= cell %>
                    </td>
                    <% } %>
                </tr>
                <% } %>
            </table>
            <% } %>
        </div>
    </div>
    <br>
    <div class="card" id="expertise">
        <h2>Domain of Expertise</h2>
        <% if(founders.length != 0) {%>
        <div id="pie-chart-container">
            <canvas id="expertise-chart"></canvas>
        </div>
        <div id="expertise-table-wrapper">
            <table id="expertise-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Expertise</th>
                    </tr>
                </thead>
                <tbody>
                    <% founders.forEach(founder => { %>
                    <tr>
                        <td><%= founder.firstName %> <%= founder.lastName %></td>
                        <td><%= founder.trackRecord.expertise %></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
        <div>No founders found.</div>
        <% }%>
    </div>
</div>
