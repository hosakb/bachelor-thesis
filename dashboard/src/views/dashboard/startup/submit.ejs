<div class="submit-cards">
    <div class="submit-card" id="submit-trl-prod">
        <h2>Technology Readiness Level</h2>
        <div class="submit-table-wrapper">
            <table id="ctrl-prod-tbl">
                <thead>
                    <tr>
                        <th>
                            Technology
                        </th>
                        <th>
                            TRL
                        </th>
                        <th>
                            Criticality
                        </th>
                        <th>
                            Options
                        </th>
                    </tr>
                </thead>
                <tbody id="trl-tbody">
                    <% let c = 0; %>
                    <% for(const i of locals.trl.trlData) {%>
                    <tr class="trl-<%= c %>">
                        <td>
                            <%= i.technology %>
                        </td>
                        <td>
                            <%= i.trl %>
                        </td>
                        <td>
                            <%= i.criticality %>
                        </td>
                        <td>
                            <div id="option-btn-<%= c %>">
                                <input type="hidden" value="<%= i.id %>" id="id-<%= c %>">
                                <button onclick="editRow('<%= c %>')">
                                    <span><i class="las la-edit"></i></span>
                                </button>
                                <button onclick="deleteRow('<%= c %>')">
                                    <span><i class="las la-trash-alt"></i></span>
                                </button>
                            </div>
                            <button id="ok-btn-<%= c %>" class="hidden" onclick="saveTrl('<%= c %>')"><i class="las la-check-circle"></i></button>
                            <button id="cancel-btn-<%= c %>" class="hidden" onclick="cancelEdit()"><i class="las la-times"></i></button>
                        </td>
                    </tr>
                    <% c++; %>
                    <% } %>
                </tbody>
            </table>
        </div>
        <br>
        <button id="add-technology-btn">Add Technology</button>
    </div>
    <div class="submit-card" id="submit-contacted-investors">
        <h2>Contacted Investors</h2>
        <div class="submit-table-wrapper">
            <table>
                <thead>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Contact Details</th>
                    <th>Date of Contact</th>
                    <th>Location</th>
                    <th>Notes</th>
                    <th>Status</th>
                </thead>
                <tbody>
                    <% for (const investor of investors) { %>
                    <tr>
                        <td><%= investor.name %> </td>
                        <td><%= investor.type %> </td>
                        <td>
                            <ul>
                                <li><%= investor.email %></li>
                                <li><%= investor.number %></li>
                                <li><%= investor.website %></li>
                            </ul>
                        </td>
                        <td>
                            <%= investor.contactDate.getDate() + "." + (investor.contactDate.getMonth() + 1) + "." + investor.contactDate.getFullYear() %>
                        </td>
                        <td>
                            <%= investor.country %>
                        </td>
                        <td>
                            <%= investor.notes %>
                        </td>
                        <td>
                            <input type="hidden" value="<%= investor.id %>">
                            <div>
                                <% if(investor.status == "contacted") { %>
                                <button id="investor-accepted" onclick="investorAccepted(this)"><i class="las la-check"></i></button>
                                <button id="investor-declined"><i class="las la-times" onclick="investorDeclined(this)"></i></button>
                                <% } else if(investor.status == "accepted")  { %>
                                <span><i class="las la-check"></i></span>
                                <% } else if(investor.status == "declined")  { %>
                                <span><i class="las la-times"></i></span>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
        <button id="add-investor">Add new Investor</button>
    </div>
    <div class="submit-card" id="submit-milestones">
        <h2>Milestones</h2>
        <div>
            <div>
                <button id="milestones-form-btn">Add Milestones</button>
            </div>
            <div id="milestones-tbl" class="submit-table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Milestone</th>
                            <th>Start Date</th>
                            <th>Due Date</th>
                            <th>Progress</th>
                            <th>Options</th>
                        </tr>
                    </thead>
                    <tbody id="milestones-list-tbody">
                        <% let j = 0; %>
                        <% for(const i of locals.milestones) {%>
                        <tr class="milestone-<%= j %>">
                            <td>
                                <%= i.name %>
                            </td>
                            <td>
                                <%= i.start %>
                            </td>
                            <td>
                                <%= i.end %>
                            </td>
                            <td>
                                <%= i.progress %>
                            </td>
                            <td>
                                <div id="milestone-option-btn-<%= j %>">
                                    <input type="hidden" value="<%= i.id %>" id="milestone-<%= j %>">
                                    <button onclick="editMilestoneRow('<%= j %>')">
                                        <span><i class="las la-edit"></i></span>
                                    </button>
                                    <button onclick="deleteMilestoneRow('<%= j %>')">
                                        <span><i class="las la-trash-alt"></i></span>
                                    </button>
                                </div>
                                <button id="milestone-ok-btn-<%= j %>" class="hidden" onclick="saveMilestone('<%= j %>')"><i class="las la-check-circle"></i></button>
                                <button id="milestone-cancel-btn-<%= j %>" class="hidden" onclick="cancelEdit()"><i class="las la-times"></i></button>
                            </td>
                        </tr>
                        <% j++; %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="submit-card" id="submit-cap-table">
        <h2>Capitalization Table</h2>
        <button id="next-investment-round-btn">Next investment round</button>
        <% if(locals.capTable != undefined) { %>
        <div class="submit-table-wrapper">
            <table id="cap-table">
                <% for(const row of locals.capTable) {%>
                <tr>
                    <% for(const cell of row) {%>
                    <td>
                        <%= cell %>
                    </td>
                    <% } %>
                </tr>
                <% } %>
            </table>
        </div>
        <% } %>
        <input type="hidden" id="current-investment-phase" value="<%= investmentPhase %>">
    </div>
    <div class="submit-card" id="submit-patent">
        <h2>Patents</h2>
        <button id="new-patent-btn">New Patent</button>
        <div class="submit-table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Invention</th>
                        <th>Inventor</th>
                        <th>Status</th>
                        <th>Last Status Change</th>
                        <th>Options/Info</th>
                    </tr>
                </thead>
                <tbody id="patent-tbody">
                    <% for(const patent of locals.patents) { %>
                    <tr>
                        <td>
                            <%= patent.invention %>
                        </td>
                        <td>
                            <%= patent.inventor %>
                        </td>
                        <td>
                            <%= patent.status %>
                        </td>
                        <td>
                            <%= patent.updatedAt.getDate() + "." + (patent.updatedAt.getMonth() + 1) + "." + patent.updatedAt.getFullYear() %>
                        </td>
                        <td>
                            <button onclick="updatePatentStatus('<%= JSON.stringify(patent) %>')">
                                <span><i class="las la-info"></i></span>
                            </button>
                            <% if (patent.status != "rejected" && patent.status != "canceled" && patent.status != "granted" ) { %>
                            <button onclick="cancelPatent('<%= patent.id %>')">
                                <span><i class="las la-times"></i></span>
                            </button>
                            <% } %>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="variable-pane" id="new-trl">
    <div class="variable-pane-box">
        <button id="exit-new-trl" class="exit"><i class="las la-times"></i></button>
        <h3>New Technology</h3>
        <div>
            <form action="/startup/submit/add-trl" method="post">
                <div class="form-item">
                    <label for="new-technology">Technology:</label>
                    <input type="text" name="newTechnology" id="new-technology" required />
                </div>
                <div class="form-item">
                    <label for="new-trl-value">TRL:</label>
                    <input type="number" name="newTrlValue" id="new-trl-value" min="1" max="9" required>
                </div>
                <div class="form-item">
                    <label for="new-criticality">Criticality:</label>
                    <input type="number" name="newCriticality" id="new-criticality" min="1" max="3" required>
                </div>
                <input type="submit" value="Submit">
            </form>
        </div>
        <div>
            <table>
                <thead>
                    <tr>
                        <th>TRL</th>
                        <th>Definition</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>Principal research into the core properties of the technology.</td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>'Invention' of a concept or application for the technology. Shift from principle to applied research.</td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>Initial 'proof of concept' of critical functionality through active R&D (Analytical and laboratory studies in appropriate context to validate previous analytical precondition).</td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td>Low-fidelity validation in laboratory environment. Technological advancement now focussed on meeting project requirements..</td>
                    </tr>
                    <tr>
                        <td>5</td>
                        <td>Validation of basic technological elements in a relevant environment. Test 'set-up' to be of higher fidelity than TRL 4.</td>
                    </tr>
                    <tr>
                        <td>6</td>
                        <td>High-fidelity 'alpha' prototype demonstrated in a relevant environment.</td>
                    </tr>
                    <tr>
                        <td>7</td>
                        <td>'Beta' prototype (Of appropriate or full scale) demonstrated in an operational environment.</td>
                    </tr>
                    <tr>
                        <td>8</td>
                        <td>Complete component, sub-system or system qualified to relevant project requirements and/or regulatory standards.</td>
                    </tr>
                    <tr>
                        <td>9</td>
                        <td>Verified component, sub-system or system proven to meet all project requirements through 'real world' operation.</td>
                    </tr>
                </tbody>
            </table>
            <br>
            <table>
                <thead>
                    <tr>
                        <th>Criticality Value</th>
                        <th>Definition</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>3</td>
                        <td>Technology is 'enabling' to the core functionality of the product. No work-around or substitution possible.</td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Technology fulfils a vital role in the product's core functionality. However, a work-around may be possible using substitute technology that will incur an acceptable penalty.</td>
                    </tr>
                    <tr>
                        <td>1</td>
                        <td>Technology is 'enhancing' to the products performance, cost, etc. Several alternative technologies exist that could be substituted and incur a minimal penalty.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
