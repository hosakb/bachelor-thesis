<div class="cards">
    <div class="card-milestone" id="milestones">
        <h2>Milestones</h2>
        <div class="overflow-chart">
            <% if(dashboard == "fund") { %>
            <svg id="gantt" class="disable-interaction"></svg>
            <% } else if(dashboard == "startup") {%>
            <svg id="gantt"></svg>
            <% } %>
        </div>
        <div>
            <button onclick="change_view_mode('Day')">Day</button>
            <button onclick="change_view_mode('Week')">Week</button>
            <button onclick="change_view_mode('Month')">Month</button>
            <button onclick="change_view_mode('Year')">Year</button>
        </div>
        <div id="gantt-changes" class="hidden">
            <% if(dashboard == "startup") {%>
            <button id="gantt-changes-ok-btn">Ok</button>
            <button id="gantt-changes-cancel-btn">Cancel</button>
            <% } %>
        </div>
    </div>
    <div class="card-startup-metrics" id="cash-runway">
        <div>
            <h2>
                Cash Runway
            </h2>
            <div class="chart-container">
                <canvas id="runway-chart"></canvas>
            </div>
        </div>
    </div>
    <div class="card-startup-metrics" id="burn-rate">
        <div>
            <h2>
                Burn Rate
            </h2>
            <div class="chart-container">
                <canvas id="burn-rate-chart"></canvas>
            </div>
        </div>
    </div>
    <div class="card-startup-metrics" id="liquidity">
        <div>
            <h2>
                Liquidity
            </h2>
            <div class="chart-container">
                <canvas id="liq-chart"></canvas>
            </div>
        </div>
    </div>
     <% if(dashboard == "fund") { %>
    <div class="card-startup-metrics" id="trl">
        <div id="trl-prod-metric">
            <h2>
                <%= locals.trl.trlProd ?? "–" %>
            </h2>
            <span>TRL(PROD) of <%= locals.trl.product%> </span>
        </div>
        <br>
        <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>
                        Technology
                    </th>
                    <th>
                        TRL
                    </th>
                    <th>
                        Criticality
                    </th>
                </tr>
            </thead>
            <% for(const i of locals.trl.trlData) {%>
            <tr>
                <td>
                    <%= i.technology %>
                </td>
                <td>
                    <%= i.trl %>
                </td>
                <td>
                    <%= i.criticality %>
                </td>
            </tr>
            <% } %>
        </table>
        </div>
    </div>
    <br>
    <div class="card-startup-table" id="contacted-investors">
        <h2>Contacted Investors</h2>
        <div class="table-container">
            <table>
                <thead>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Contact Details</th>
                    <th>Date of Contact</th>
                    <th>Location</th>
                    <th>Notes</th>
                    <th>Status</th>
                </thead>
                <tbody>
                    <% for (const investor of investors) { %>
                    <tr>
                        <td><%= investor.name %> </td>
                        <td><%= investor.type %> </td>
                        <td>
                            <ul>
                                <li><%= investor.email %></li>
                                <li><%= investor.number %></li>
                                <li><%= investor.website %></li>
                            </ul>
                        </td>
                        <td>
                            <%= investor.contactDate.getDate() + "." + (investor.contactDate.getMonth() + 1) + "." + investor.contactDate.getFullYear() %>
                        </td>
                        <td>
                            <%= investor.country %>
                        </td>
                        <td>
                            <%= investor.notes %>
                        </td>
                        <td>
                            <input type="hidden" value="<%= investor.id %>">
                            <div>
                                <% if(investor.status == "contacted") { %>
                                <span><i class="las la-hourglass-half"></i></span>
                                <% } else if(investor.status == "accepted")  { %>
                                <span><i class="las la-check"></i></span>
                                <% } else if(investor.status == "declined")  { %>
                                <span><i class="las la-times"></i></span>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-startup-table" id="patent">
        <h2>Patents</h2>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Invention</th>
                        <th>Inventor</th>
                        <th>Phase</th>
                        <th>Last Status Change</th>
                        <th>Options/Info</th>
                    </tr>
                </thead>
                <tbody id="patent-tbody">
                    <% for(const patent of locals.patents) { %>
                    <tr>
                        <td>
                            <%= patent.invention %>
                        </td>
                        <td>
                            <%= patent.inventor %>
                        </td>
                        <td>
                            <%= patent.status %>
                        </td>
                        <td>
                            <%= patent.updatedAt.getDate() + "." + (patent.updatedAt.getMonth() + 1) + "." + patent.updatedAt.getFullYear() %>
                        </td>
                        <td>
                            <button onclick="patentInfo('<%= JSON.stringify(patent) %>')">
                                <span><i class="las la-info"></i></span>
                            </button>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %> 
</div>
<div class="variable-pane" id="patent-info-pane">
    <div class="variable-pane-box">
        <button id="exit-patent-info" class="exit"><i class="las la-times"></i></button>
        <h3>Patent Information</h3>
        <h4 id="invention-header"></h4>
        <br>
        <div id="initial-application" class="hidden">
            <h4>Application filed. No confirmation received yet.</h4>
        </div>
        <div id="disclosure-phase" class="hidden">
            <table>
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Application Confirmed On</td>
                        <td id="application-filed-date"></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>Submission Fee Deadline</td>
                        <td id="submission-fee-deadline"></td>
                        <td>
                            <span id="submission-fee-deadline-check" class="hidden"><i class="las la-check-circle"></i></span>
                        </td>
                    </tr>
                    <tr>
                        <td>Next Annual Fee Deadline</td>
                        <td id="annual-fee-deadline"></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>Research Result Deadline</td>
                        <td id="research-result-deadline"></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>Parallel Patent Submission Deadline</td>
                        <td id="parallel-patent-deadline"></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>Inventor Nomination Deadline</td>
                        <td id="inventor-nomination-deadline"></td>
                        <td>
                            <span id="inventor-nomination-deadline-check" class="hidden"><i class="las la-check-circle"></i></span>
                        </td>
                    </tr>
                    <tr>
                        <td>Compensation Claim Deadline</td>
                        <td id="compensation-claim-deadline"></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>Disclosure</td>
                        <td id="disclosure-deadline"></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>Secrecy</td>
                        <td id="secrecy-deadline"></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>Addition Patents Deadline</td>
                        <td id="additional-patent-deadline"></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>Patent Examination Request Deadline</td>
                        <td id="examination-request-deadline"></td>
                        <td>
                            <span id="examination-request-deadline-check" class="hidden"><i class="las la-check-circle"></i></span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div id="examination-phase" class="hidden">
            <table>
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Date of Received Examination notice</td>
                        <td id="examination-notice-date"></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>Examination notice Deadline</td>
                        <td id="examination-notice-deadline"></td>
                        <td>
                            <span id="examination-notice-deadline-check" class="hidden"><i class="las la-check-circle"></i></span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div id="objection-phase" class="hidden">
            <div>
                <h3>The patent has been granted for granted for:</h3>
                <h2 id="objection-granted-duration"></h2>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Patent grant date</td>
                        <td id="objection-granted-on"></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>Grant Fee Deadline</td>
                        <td id="grant-fee-deadline"></td>
                        <td>
                            <span id="grant-fee-deadline-check" class="hidden"><i class="las la-check-circle"></i></span>
                        </td>
                    </tr>
                    <tr>
                        <td>Objection filing deadline</td>
                        <td id="objection-filing-deadline"></td>
                        <td>
                            <span id="objection-filing-deadline-check" class="hidden"><i class="las la-check-circle"></i></span>
                        </td>
                    </tr>
                    <tr>
                        <td>Objection response deadline</td>
                        <td id="objection-response-deadline"></td>
                        <td>
                            <span id="objection-response-deadline-check" class="hidden"><i class="las la-check-circle"></i></span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div id="granted" class="hidden">
            <div>
                <h3>The patent has been granted for granted for:</h3>
                <h2 id="granted-duration"></h2>
            </div>
            <div>
                <label>Granted on:</label>
                <span id="granted-on"></span>
            </div>
        </div>
        <div id="rejected" class="hidden">
            <div>
                <label>The patent has been <span id="cancel-status"></span> or has been canceled due to:</label>
                <p id="rejection-reason"></p>
            </div>
            <div>
                <label>Date:</label>
                <span id="rejected-on"></span>
            </div>
        </div>
    </div>
</div>
