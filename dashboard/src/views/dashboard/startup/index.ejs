<div class="cards">
    <div class="card-milestone" id="milestones">
        <h2>Milestones</h2>
        <div class="overflow-chart">
            <% if(dashboard == "fund") { %>
            <svg id="gantt" class="disable-interaction"></svg>
            <% } else if(dashboard == "startup") {%>
            <svg id="gantt"></svg>
            <% } %>
        </div>
        <div>
            <button onclick="change_view_mode('Day')">Day</button>
            <button onclick="change_view_mode('Week')">Week</button>
            <button onclick="change_view_mode('Month')">Month</button>
            <button onclick="change_view_mode('Year')">Year</button>
        </div>
        <div id="gantt-changes" class="hidden">
            <% if(dashboard == "startup") {%>
            <button id="gantt-changes-ok-btn">Ok</button>
            <button id="gantt-changes-cancel-btn">Cancel</button>
            <% } %>
        </div>
    </div>
    <div class="card-startup-metrics" id="cash-runway">
        <div>
            <h2>
                Cash Runway
            </h2>
            <div class="chart-container">
                <canvas id="runway-chart"></canvas>
            </div>
        </div>
    </div>
    <div class="card-startup-metrics" id="burn-rate">
        <div>
            <h2>
                Burn Rate
            </h2>
            <div class="chart-container">
                <canvas id="burn-rate-chart"></canvas>
            </div>
        </div>
    </div>
    <div class="card-startup-metrics" id="liquidity">
        <div>
            <h2>
                Liquidity
            </h2>
            <div class="chart-container">
                <canvas id="liq-chart"></canvas>
            </div>
        </div>
    </div>
    <div class="card-startup-metrics" id="trl">
        <div id="trl-prod-metric">
            <h2>
                <%= locals.trl.trlProd %>
            </h2>
            <span>TRL(PROD) of <%= locals.trl.product%> </span>
        </div>
        <br>
        <table>
            <thead>
                <tr>
                    <th>
                        Technology
                    </th>
                    <th>
                        TRL
                    </th>
                    <th>
                        Criticality
                    </th>
                </tr>
            </thead>
            <% for(const i of locals.trl.trlData) {%>
            <tr>
                <td>
                    <%= i.technology %>
                </td>
                <td>
                    <%= i.trl %>
                </td>
                <td>
                    <%= i.criticality %>
                </td>
            </tr>
            <% } %>
        </table>
    </div>
    <br>
    <div class="card-startup-table" id="contacted-investors">
        <h2>Contacted Investors</h2>
        <div class="table-container">
            <table>
                <thead>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Contact Details</th>
                    <th>Date of Contact</th>
                    <th>Location</th>
                    <th>Notes</th>
                    <th>Status</th>
                </thead>
                <tbody>
                    <% for (const investor of investors) { %>
                    <tr>
                        <td><%= investor.name %> </td>
                        <td><%= investor.type %> </td>
                        <td>
                            <ul>
                                <li><%= investor.email %></li>
                                <li><%= investor.number %></li>
                                <li><%= investor.website %></li>
                            </ul>
                        </td>
                        <td>
                            <%= investor.contactDate %>
                        </td>
                        <td>
                            <%= investor.country %>
                        </td>
                        <td>
                            <%= investor.notes %>
                        </td>
                        <td>
                            <input type="hidden" value="<%= investor.id %>">
                            <div>
                                <% if(investor.status == "contacted") { %>
                                <span><i class="las la-hourglass-half"></i></span>
                                <% } else if(investor.status == "accepted")  { %>
                                <span><i class="las la-check"></i></span>
                                <% } else if(investor.status == "declined")  { %>
                                <span><i class="las la-times"></i></span>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
    <% if(dashboard == "fund") { %>
        <div class="card-startup-table" id="patent">
            <h2>Patents</h2>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Invention</th>
                            <th>Inventor</th>
                            <th>Status</th>
                            <th>Last Status Change</th>
                            <th>Options/Info</th>
                        </tr>
                    </thead>
                    <tbody id="patent-tbody">
                        <% for(const patent of locals.patents) { %>
                        <tr>
                            <td>
                                <%= patent.invention %>
                            </td>
                            <td>
                                <%= patent.inventor %>
                            </td>
                            <td>
                                <%= patent.status %>
                            </td>
                            <td>
                                <%= patent.updatedAt.getDate() + "." + patent.updatedAt.getMonth() + "." + patent.updatedAt.getFullYear() %>
                            </td>
                            <td>
                                <button onclick="patentInfo('<%= JSON.stringify(patent) %>')">
                                    <span><i class="las la-info"></i></span>
                                </button>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %> 
</div>
