<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" type="text/css" href="/css/frappe-gantt.min.css">
    <link rel="stylesheet" type="text/css" href="/css/line-awesome.min.css">
    <link rel="stylesheet" type="text/css" href="/css/dashboard.css">
    <link rel="stylesheet" type="text/css" href="/css/theme.css">
</head>

<body class="app layout-dashboard">
    <% if(dashboard == "fund") {%>
    <%- include("../partials/sidebar_fund.ejs") %>
    <% } else if(dashboard == "startup") { %>
    <%- include("../partials/sidebar_startup.ejs", {page}) %>
    <% } %>

    <div class="main-content">
        <%- include("../partials/header.ejs", {title, name}) %>
        <main>
            <%- body %>
        </main>
        <footer></footer>
    </div>

    <% for (const script of scripts) { %>
    <script type="application/javascript" src="<%= script %>.js" defer></script>
    <% } %>
    <% if (scripts.includes("/js/chart/chart.min")) { %>
    <script type="application/javascript" src="/js/chart-theme.js" defer></script>
    <% } %>
</body>

</html>
